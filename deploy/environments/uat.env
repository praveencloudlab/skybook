# UAT — acceptance evidence for the human gate. Mirrors prod settings except mail, which stays in the sink so acceptance runs never email a real inbox.
SKYBOOK_ENV=uat
COMPOSE_PROJECT_NAME=skybook-uat
LOG_LEVEL=INFO
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SKYBOOK_BOOTSTRAP_ADMIN_EMAIL=uat-admin@skybook.ci

# Secrets: generated per run by the pipeline (see promote.yml) - the
# same throwaway-keypair pattern the nightly certification uses.
