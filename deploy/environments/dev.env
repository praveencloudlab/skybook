# DEV — first landing of every main commit. Noisy logs, mail stays in the sink, demo admin bootstrapped so the smoke can exercise an authenticated path.
SKYBOOK_ENV=dev
COMPOSE_PROJECT_NAME=skybook-dev
LOG_LEVEL=DEBUG
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025

# Secrets: generated per run by the pipeline (see promote.yml) - the
# same throwaway-keypair pattern the nightly certification uses.
