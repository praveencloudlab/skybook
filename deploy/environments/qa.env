# TEST/QA — the certification environment. The nightly e2e suite runs here against the promoted images; its own overlay (docker-compose.e2e.yml) supplies the widened test windows on top of this file.
SKYBOOK_ENV=qa
COMPOSE_PROJECT_NAME=skybook-qa
LOG_LEVEL=INFO
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025

# Secrets: generated per run by the pipeline (see promote.yml) - the
# same throwaway-keypair pattern the nightly certification uses.
