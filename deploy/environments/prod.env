# PROD — the Oracle VM behind Caddy (docs/DEPLOY_ORACLE.md).
#
# This file carries only the non-secret environment identity. Everything
# secret or installation-specific (POSTGRES_PASSWORD, JWT keys, MAIL_*,
# SKYBOOK_DOMAIN, service client secrets) lives in the VM's own
# ~/skybook/.env and is layered by the deploy step:
#
#   docker compose --env-file .env --env-file deploy/environments/prod.env \
#     -f docker-compose.yml -f docker-compose.ladder.yml -f docker-compose.prod.yml \
#     pull && ... up -d
#
# Later --env-file flags win, so the identity below cannot be overridden by a
# stale value in the VM file, while every secret still comes from the VM only.

SKYBOOK_ENV=prod
COMPOSE_PROJECT_NAME=skybook
LOG_LEVEL=INFO
