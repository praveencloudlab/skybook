# STAGING / PRE-PROD — the dress rehearsal, on the production VM.
#
# Free-tier honesty (ENVIRONMENTS.md §4): the VM cannot carry two full stacks
# permanently, so staging is TRANSIENT - the promote pipeline stands this
# project up beside prod, smokes the promoted images through the same prod
# overlay, and tears it down before touching prod. Separate project name and
# ports are what let the two coexist for those minutes.
#
# Secrets are NOT here: the deploy step layers the VM's own ~/skybook/.env
# (staging deliberately reuses prod's secret set - a dress rehearsal with
# different keys would not be rehearsing the show).

SKYBOOK_ENV=staging
COMPOSE_PROJECT_NAME=skybook-staging
LOG_LEVEL=INFO

# Mail must never leave staging: real templates, sink delivery.
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# Staging answers on shifted host ports so prod keeps 3000/8080.
STAGING_FRONTEND_PORT=3900
STAGING_GATEWAY_PORT=8180

# Rehearsal heaps match the runners', not the VM's: staging shares the box
# with live prod and must never pressure it.
JAVA_TOOL_OPTIONS=-Xmx640m -XX:MaxMetaspaceSize=256m
