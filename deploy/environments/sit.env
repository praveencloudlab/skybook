# SIT — system integration. The question is only: do the services agree with each other through the gateway, the bus and the mail sink. INFO logs so integration failures are readable, not buried.
SKYBOOK_ENV=sit
COMPOSE_PROJECT_NAME=skybook-sit
LOG_LEVEL=INFO
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025

# Secrets: generated per run by the pipeline (see promote.yml) - the
# same throwaway-keypair pattern the nightly certification uses.
